# ============================================================
#  Anki 词汇卡牌生成器 — 环境变量模板
#  复制为 .env 并填入实际值
# ============================================================

# --- LLM API 配置 (兼容 OpenAI SDK 接口) ---
# 必填：你的 API Key
# DeepSeek 格式: sk-xxxxxxxxxxxxxxxx
LLM_API_KEY=sk-your-deepseek-api-key-here

# API Base URL（DeepSeek 官方；也可换成 OpenAI / Azure / vLLM / Ollama 等兼容端点）
LLM_BASE_URL=https://api.deepseek.com

# 模型名称（DeepSeek: deepseek-chat 或 deepseek-reasoner）
LLM_MODEL=deepseek-chat

# --- 并发与速率控制 ---
# 最大并发请求数（并发是缩短总耗时的最大杠杆；DeepSeek 建议 6-10）
MAX_CONCURRENCY=8

# 每分钟最大请求数（超出后自动等待；DeepSeek 实际配额远高于此）
RATE_LIMIT_PER_MIN=60

# 每批合并处理的单词数（配合 BATCH_MAX_TOKENS=8192，5 词输出可安全容纳）
BATCH_SIZE=5

# 单批 LLM 输出 token 上限（过小会导致富词批次 JSON 被截断；deepseek-chat 支持 8192）
BATCH_MAX_TOKENS=8192

# --- 路径配置 ---
# 默认把运行产物写入 data/*；旧的根目录 cache/media 仍会被兼容读取
DATA_DIR=data
CACHE_DIR=data/cache
MEDIA_DIR=data/media
OUTPUT_DIR=data/output
LOG_DIR=data/logs
BACKUP_DIR=data/backups

# --- 行为开关 ---
# 是否将例句中所有匹配的单词都替换为填空（默认仅首次出现）
REPLACE_ALL=false

# 是否启用音频生成（gTTS）
AUDIO_ENABLED=true

# 最低处理的重要性等级（低/中/高/极高），低于此等级的单词会被跳过
IMPORTANCE_MIN_LEVEL=低

# --- 音频 TTS 引擎 ---
# auto: 优先 gTTS；gTTS 不可达且已安装 edge-tts 时自动退到 Edge TTS
# 可选: auto / gtts / edge / none
TTS_PROVIDER=auto
TTS_FALLBACKS=gtts,edge
TTS_VOICE=en-GB-SoniaNeural

# 使用 Edge TTS 作为替代发音源：pip install edge-tts
